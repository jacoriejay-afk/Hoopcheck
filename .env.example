# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# HoopFeed AI moderation
OPENAI_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_ENABLED=true
STRIPE_CHECKOUT_MODE=test

# Application
NEXT_PUBLIC_SITE_URL=https://hoopcheck.online
API_SPORTS_BASKETBALL_KEY=

# Apple App Store Server API / IAP (server-only; leave unset until Apple setup is complete)
# Must match the permanent iOS bundle ID registered in App Store Connect.
APPLE_IAP_BUNDLE_ID=
# Explicitly select Sandbox during testing; use Production only after release readiness review.
APPLE_IAP_ENVIRONMENT=Sandbox
# Required for Production SignedDataVerifier configuration.
APPLE_IAP_APPLE_ID=
# Comma-separated Base64-encoded DER Apple root certificates (server-only).
APPLE_ROOT_CA_CERTIFICATES_BASE64=
# Exact App Store Connect product IDs; do not use display names or prices.
APPLE_IAP_PRO_PRODUCT_ID=
APPLE_IAP_PREMIUM_PRODUCT_ID=
