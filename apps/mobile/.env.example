# Copy to .env.local for local development. Use only the public/publishable key.
# Do not put service-role keys, database passwords, Stripe secrets, or signing secrets here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Public HTTPS origin for the deployed HoopCheck web API (no trailing slash).
EXPO_PUBLIC_HOOPCHECK_API_URL=https://YOUR_HOOPCHECK_WEB_APP_DOMAIN
