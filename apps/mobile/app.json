{
  "expo": {
    "name": "HoopCheck",
    "slug": "hoopcheck-mobile",
    "icon": "./assets/app-icon.png",
    "version": "0.2.0",
    "orientation": "portrait",
    "scheme": "hoopcheck",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow HoopCheck to securely protect your sign-in session."
        }
      ],
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/hoopcheck-mark.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#07070A",
          "dark": {
            "image": "./assets/hoopcheck-mark.png",
            "backgroundColor": "#07070A"
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock HoopCheck after five minutes away using Face ID. Normal sign-in is always available."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos and videos to share on HoopCheck or customize your profile.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "online.hoopcheck.app",
      "associatedDomains": [
        "applinks:hoopcheck.online"
      ]
    },
    "android": {
      "package": "online.hoopcheck.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "hoopcheck.online",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "owner": "hoopcheck",
    "extra": {
      "eas": {
        "projectId": "62f822cb-ab9a-42ba-8456-007d2822ef70"
      }
    }
  }
}
