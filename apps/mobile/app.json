{
  "expo": {
    "name": "HoopCheck",
    "slug": "hoopcheck-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "hoopcheck",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow HoopCheck to securely protect your sign-in session."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.hoopcheck"
    },
    "android": {
      "package": "com.example.hoopcheck"
    }
  }
}
