    },
    {
      "name": "Team affiliations owner or admin read",
      "check": null,
      "roles": [
        "authenticated"
      ],
      "table": "player_team_affiliations",
      "using": "((user_id = ( SELECT auth.uid() AS uid)) OR is_current_user_admin_or_moderator())",
      "command": "SELECT"
    },
    {
      "name": "Players can submit own verification requests",
      "check": "((user_id = ( SELECT auth.uid() AS uid)) AND (status = 'pending'::text) AND (EXISTS ( SELECT 1\n   FROM profiles p\n  WHERE ((p.id = ( SELECT auth.uid() AS uid)) AND (p.account_type = 'player'::text)))))",
      "roles": [
        "authenticated"
      ],
      "table": "player_verification_requests",
      "using": null,
      "command": "INSERT"
    },
    {
      "name": "Verification requests owner or admin read",
      "check": null,
      "roles": [
        "authenticated"
      ],
      "table": "player_verification_requests",
      "using": "((user_id = ( SELECT auth.uid() AS uid)) OR (EXISTS ( SELECT 1\n   FROM admin_roles ar\n  WHERE ((ar.user_id = ( SELECT auth.uid() AS uid)) AND (TRIM(BOTH FROM lower(ar.role)) = ANY (ARRAY['admin'::text, 'moderator'::text]))))))",
      "command": "SELECT"
    },
    {
      "name": "approved owners manage profile claim queue",
      "check": "is_approved_claim_owner()",
      "roles": [
        "authenticated"
      ],
      "table": "profile_claim_requests",
      "using": "is_approved_claim_owner()",
      "command": "UPDATE"
    },
    {
      "name": "claim request owners can read own",
      "check": null,
      "roles": [
        "authenticated"
      ],
      "table": "profile_claim_requests",
      "using": "((requester_id = ( SELECT auth.uid() AS uid)) OR is_current_user_admin_or_moderator())",
      "command": "SELECT"
    },
    {
      "name": "coaches and managers can submit profile claims",
      "check": "((requester_id = ( SELECT auth.uid() AS uid)) AND (status = 'pending'::text) AND (EXISTS ( SELECT 1\n   FROM profiles p\n  WHERE ((p.id = ( SELECT auth.uid() AS uid)) AND (p.account_type = ANY (ARRAY['coach'::text, 'manager'::text]))))))",
      "roles": [
        "authenticated"
      ],
      "table": "profile_claim_requests",
